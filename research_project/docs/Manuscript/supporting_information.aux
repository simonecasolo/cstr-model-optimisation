\@writefile{toc}{\contentsline {paragraph}{\numberline {g}Interpretation.}{8}{section*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces SBC rank histograms for the production NSF posterior, trained and evaluated under the matched scenario-specific warm-start protocol ($N_\mathrm  {SBC}=500$ test cases, $L=1{,}000$ posterior draws each). Dashed line: expected uniform density. Rank uniformity cannot be rejected for either marginal (KS $p=0.30$ for $\alpha $, $p=0.75$ for $\beta $), consistent with a well-calibrated posterior. The C2ST scores of 0.56 and 0.52 (near the uninformative 0.5 baseline) corroborate this: the trained density estimator's own rank statistics are indistinguishable from uniform, consistent with the genuine Fisher-information asymmetry between $\alpha $ and $\beta $ (Section\nobreakspace  {}4.3 of the main text) being correctly, not overconfidently, represented. (Exact $p$-values vary run-to-run; see the main text's discussion of the observed range.)\relax }}{8}{figure.caption.29}\protected@file@percent }
\newlabel{fig:si_sbc_ranks}{{7}{8}{SBC rank histograms for the production NSF posterior, trained and evaluated under the matched scenario-specific warm-start protocol ($N_\mathrm {SBC}=500$ test cases, $L=1{,}000$ posterior draws each). Dashed line: expected uniform density. Rank uniformity cannot be rejected for either marginal (KS $p=0.30$ for $\alpha $, $p=0.75$ for $\beta $), consistent with a well-calibrated posterior. The C2ST scores of 0.56 and 0.52 (near the uninformative 0.5 baseline) corroborate this: the trained density estimator's own rank statistics are indistinguishable from uniform, consistent with the genuine Fisher-information asymmetry between $\alpha $ and $\beta $ (Section~4.3 of the main text) being correctly, not overconfidently, represented. (Exact $p$-values vary run-to-run; see the main text's discussion of the observed range.)\relax }{figure.caption.29}{}}
\newlabel{fig:si_sbc_ranks@cref}{{[figure][7][]7}{[1][8][]8}}
