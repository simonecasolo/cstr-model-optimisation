\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Prior predictive check ($N=500$ prior draws) for four key summary features: $s_{U\!A}$, $s_{k_0}$, $\bar  {C}$, and $\bar  {Q}_c$. \textit  {Top row:} kernel density estimates of the prior-predictive distribution (blue fill) with observed values from each closed-loop scenario overlaid as tick marks. \textit  {Bottom row:} histogram of prior-predictive values with per-scenario means marked as vertical lines. All scenario observations fall within the prior-predictive envelope, confirming that the simulator covers the operating regime of the evaluation set.\relax }}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:si_simulator_sanity}{{3}{4}{Prior predictive check ($N=500$ prior draws) for four key summary features: $s_{U\!A}$, $s_{k_0}$, $\bar {C}$, and $\bar {Q}_c$. \textit {Top row:} kernel density estimates of the prior-predictive distribution (blue fill) with observed values from each closed-loop scenario overlaid as tick marks. \textit {Bottom row:} histogram of prior-predictive values with per-scenario means marked as vertical lines. All scenario observations fall within the prior-predictive envelope, confirming that the simulator covers the operating regime of the evaluation set.\relax }{figure.caption.9}{}}
\newlabel{fig:si_simulator_sanity@cref}{{[figure][3][]3}{[1][3][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Training budget sensitivity: 2-D posterior scatter plots $[\alpha ,\beta ]$ for Sc\,1 (healthy, top row) and Sc\,2 (jacket fouling, bottom row) at three simulation budgets (MAF estimator, matched scenario-specific warm-start protocol). Dashed lines mark the true parameter values. The Sc\,2 $\beta $ posterior mean ($\hat  \beta \approx 0.73$--$0.75$, true $0.70$) changes little beyond $n_\mathrm  {sim}=5{,}000$, motivating the production budget of $10{,}000$; this MAF ablation's small residual overshoot is a property of this specific estimator/seed combination and is larger than the production NSF posterior's bias ($\hat  \beta =0.6978$, Section\nobreakspace  {}6.1 of the main text) --- see the discussion text for why the two are not expected to match exactly.\relax }}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:si_sensitivity}{{4}{4}{Training budget sensitivity: 2-D posterior scatter plots $[\alpha ,\beta ]$ for Sc\,1 (healthy, top row) and Sc\,2 (jacket fouling, bottom row) at three simulation budgets (MAF estimator, matched scenario-specific warm-start protocol). Dashed lines mark the true parameter values. The Sc\,2 $\beta $ posterior mean ($\hat \beta \approx 0.73$--$0.75$, true $0.70$) changes little beyond $n_\mathrm {sim}=5{,}000$, motivating the production budget of $10{,}000$; this MAF ablation's small residual overshoot is a property of this specific estimator/seed combination and is larger than the production NSF posterior's bias ($\hat \beta =0.6978$, Section~6.1 of the main text) --- see the discussion text for why the two are not expected to match exactly.\relax }{figure.caption.11}{}}
\newlabel{fig:si_sensitivity@cref}{{[figure][4][]4}{[1][3][]4}}
\citation{Zhou2021}
